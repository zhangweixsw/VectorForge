<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VectorForgeSetup</AssemblyName>
    <RootNamespace>VectorForgeSetup</RootNamespace>
    <ApplicationIcon>..\VectorForge\Assets\VectorForge.ico</ApplicationIcon>
    <Version>18.0.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PayloadPath Condition="'$(PayloadPath)' == ''">..\..\dist\win-x64-v18.0.1\VectorForge.exe</PayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="VectorForge.Setup.Payload.exe" />
  </ItemGroup>
</Project>
